+-- Check whether a MediaTek HNAT module exists
+local function module_file_exists(kernel, names)
+	if not kernel or kernel == "" then
+		return false
+	end
+
+	for _, name in ipairs(names) do
+		for _, ext in ipairs({ ".ko", ".ko.gz", ".ko.xz", ".ko.zst" }) do
+			if fs.access("/lib/modules/" .. kernel .. "/" .. name .. ext) then
+				return true
+			end
+		end
+	end
+
+	return false
+end
+
+-- Check whether a module is already loaded
+local function module_loaded(names)
+	for _, name in ipairs(names) do
