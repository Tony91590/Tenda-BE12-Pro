diff --git a/tests/runtime/README.md b/tests/runtime/README.md
new file mode 100644
index 00000000000..93f39d21885
--- /dev/null
+++ b/tests/runtime/README.md
@@ -0,0 +1,37 @@
+# Runtime script regression tests
+
+Run from the repository root:
+
+```sh
+python3 tests/runtime/test_runtime.py
+```
+
+Requirements: Python 3, a POSIX shell, and Lua 5.1 or LuaJIT. By default the
+runner uses available `luajit` and `lua` executables. Override with `TEST_LUA`
+(space-separated executables) and `TEST_SHELL` (one shell executable path).
+The CI workflow uses Lua 5.1, LuaJIT and BusyBox ash.
+
+The tests execute the real Lua configuration generator and shell service
+functions with mocked native modules, commands, profile storage and netifd
+notifications. Service filesystem writes are redirected into temporary trees.
+They do not access a router, modify host network settings or load kernel modules.
+All credentials are synthetic fixtures.
+
+Coverage:
+
+- A valid WPA3/EHT configuration still produces the expected encryption and PMF
+  settings and starts the AP interface.
+- Invalid/empty input, missing profiles, unsupported encryption, invalid wireless
+  modes and interface failures propagate to a nonzero exit status.
+- Neither input values nor old/new keys appear in diagnostics; summaries are
+  bounded in size.
+- Interrupted sleeps resume the remaining duration without busy waiting.
+- The real rc.common stop callback completes without shutting down Wi-Fi or
+  recursively calling stop.
+- Starting turboacc does not clear caches, change memory watermarks or rewrite
+  wget preferences, and does not commit unrelated firewall edits.
+- Failed netifd setup releases the acquired lock and never reports the radio up.
+
+These tests are not a firmware build or hardware qualification. They do not
+prove radio throughput, group-key operation, multicast delivery or recovery
+from a partially completed driver reload.
diff --git a/tests/runtime/test_mtwifi.lua b/tests/runtime/test_mtwifi.lua
new file mode 100644
index 00000000000..de462e44343
--- /dev/null
+++ b/tests/runtime/test_mtwifi.lua
@@ -0,0 +1,112 @@
+-- Host-side regression tests; all router I/O and native modules are mocked.
+local base = "package/mtk/applications/mtwifi-cfg/files/mtwifi-cfg/"
+package.path = base .. "?.lua;" .. package.path
+local case = arg[1]
+local logs, commands, saved, sleeps = {}, {}, nil, {}
+local secret, old_secret = "fixture-secret-NEW", "fixture-secret-OLD"
+local fixture = {
+    device = "radio5",
+    config = {band = "5g", htmode = "EHT160", channel = "36"},
+    interfaces = {["0"] = {
+        mtwifi_ifname = "rai0",
+        config = {mode = "ap", encryption = "sae", ssid = "fixture", key = secret}
+    }}
+}
+local decode_error, missing_profile, empty_input, interface_error
+if case == "invalid-json" then decode_error = true
+elseif case == "missing-profile" then missing_profile = true
+elseif case == "empty-input" then empty_input = true
+elseif case == "invalid-encryption" then fixture.interfaces["0"].config.encryption = "unsupported"
+elseif case == "invalid-structure" then fixture = false
+elseif case == "unknown-device" then fixture.device = "absent"
+elseif case == "no-interfaces" then fixture.interfaces = {}
+elseif case == "invalid-mode" then fixture.config.band = "bad"
+elseif case == "invalid-htmode" then fixture.config.htmode = nil
+elseif case == "interface-failure" then interface_error = true
+elseif case == "too-many-stations" then
+    fixture.interfaces["0"].config.mode = "sta"
+    fixture.interfaces["1"] = {config = {mode = "sta", encryption = "sae"}}
+end
+
+local nixio = {
+    syslog = function(level, message) logs[#logs + 1] = message end,
+    nanosleep = function(seconds, nanoseconds)
+        sleeps[#sleeps + 1] = {seconds, nanoseconds}
+        if case == "sleep-error" then return nil, "error", 22 end
+        if #sleeps == 1 then return false, 0, 250000000 end
+        return true
+    end
+}
+package.preload.nixio = function() return nixio end
+local utils = require "mtwifi_utils"
+
+if case == "sleep" then
+    utils.sleep(1.5)
+    assert(#sleeps == 2)
+    assert(sleeps[1][1] == 1 and sleeps[1][2] == 500000000)
+    assert(sleeps[2][1] == 0 and sleeps[2][2] == 250000000)
+elseif case == "sleep-error" then
+    assert(not pcall(utils.sleep, 1))
+    assert(#sleeps == 1)
+elseif case == "bounded-log" then
+    local diff = {}
+    for i = 1, 1000 do diff["WPAPSK" .. i] = {old_secret, secret} end
+    utils.log_config_changes(diff)
+    assert(#logs == 1 and #logs[1] < 1100)
+else
+    package.preload.cjson = function() return {decode = function()
+        if decode_error then error(secret) end
+        return fixture
+    end} end
+    package.preload.l1dat_parser = function() return {
+        load_l1_profile = function() return {devname_ridx = {radio5 = {
+            profile_path = "/fixture/profile.dat", main_ifname = "rai0",
+            ext_ifname = "rai", apcli_ifname = "apclii", wds_ifname = "wdsi",
