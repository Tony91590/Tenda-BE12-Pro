+name: Runtime script regression tests
+
+on:
+  push:
+    paths:
+      - 'package/mtk/applications/mtwifi-cfg/**'
+      - 'package/mtk/applications/luci-app-turboacc-mtk/**'
+      - 'package/base-files/files/etc/rc.common'
