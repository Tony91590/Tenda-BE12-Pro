From b2958254ac34d40eac6f04956b95a5cf6cc383f2 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Tue, 27 Oct 2026 13:44:45 +0000
Subject: [PATCH] wifi-scripts: set up a changed radio after netifd adds the
 interfaces

Since netifd commit aaf5b194b15d ("proto-ucode: add ucode protocol
handler infrastructure"), config_init_all() runs the ucode config_init
before config_init_interfaces(). update() then sets a running radio up
from inside config_init, and interface_get_bridge() does not find an
interface that the same reload adds. A reload that adds a VLAN bridge
and moves an AP to it thus sets the radio up without a bridge for that
AP, and hostapd replaces the BSS. When the bridge comes up,
check_interfaces() sets the radio up again with the bridge, and hostapd
replaces the BSS a second time.

Do not set up a radio while netifd runs config_init; apply the change in
config_start, which netifd calls after interface_start_pending().
update() only marks the change. check_interfaces() does nothing from
config_init to config_start: interface_set_up() calls it inside
config_init_interfaces() for an interface that the reload reloads, and
in interface_start_pending(), before config_start. config_start starts
each radio and then sets up a running radio with a change. This is the
order of the C wireless code, where __wireless_device_set_up() returned
while config_init was set and wireless_start_pending() ran after
interface_start_pending().

A radio that the reload creates starts with a change, so config_start
reads its bridges again, also where the network has no ifindex yet. A
reconf call still sets the radio up at once.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
 .../files/lib/netifd/wireless-device.uc       |  2 +-
 .../wifi-scripts/files/lib/netifd/wireless.uc | 21 ++++++++++++++++---
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/package/network/config/wifi-scripts/files/lib/netifd/wireless-device.uc b/package/network/config/wifi-scripts/files/lib/netifd/wireless-device.uc
index 768c71fff2afc8..d700a2897e454f 100644
--- a/package/network/config/wifi-scripts/files/lib/netifd/wireless-device.uc
+++ b/package/network/config/wifi-scripts/files/lib/netifd/wireless-device.uc
@@ -406,7 +406,6 @@ function update(data)
 
 	wdev_reset(this);
 	this.config_change = true;
-	this.check();
 }
 
 function start()
@@ -687,6 +686,7 @@ export function new(data, script, driver)
 		ifindex_cache: {},
 
 		autostart: true,
+		config_change: true,
 		state: "down",
 	};
 	wdev_update_disabled_vifs(wdev);
diff --git a/package/network/config/wifi-scripts/files/lib/netifd/wireless.uc b/package/network/config/wifi-scripts/files/lib/netifd/wireless.uc
index 35579581035f14..a8bbb5b3a1f1d5 100644
--- a/package/network/config/wifi-scripts/files/lib/netifd/wireless.uc
+++ b/package/network/config/wifi-scripts/files/lib/netifd/wireless.uc
@@ -18,6 +18,10 @@ let wireless = netifd.wireless = {
 	path: realpath(netifd.main_path + "/wireless"),
 };
 
+// netifd runs config_init before it adds the interfaces of the reload: set
+// up no radio until config_start, which it calls after interface_start_pending()
+let config_pending;
+
 function wpad_update_mlo(service, mode)
 {
 	let config = {};
@@ -169,6 +173,8 @@ function update_config(new_devices, mlo_vifs)
 
 function config_init(uci)
 {
+	config_pending = true;
+
 	let config = uci.get_all("wireless");
 
 	let handlers = {};
@@ -414,14 +420,22 @@ function config_init(uci)
 
 function config_start()
 {
-	for (let name, dev in wireless.devices)
-		if (dev.autostart)
-			dev.start();
+	config_pending = false;
+
+	for (let name, dev in wireless.devices) {
+		if (!dev.autostart)
+			continue;
 
+		dev.start();
+		dev.check();
+	}
 }
 
 function check_interfaces()
 {
+	if (config_pending)
+		return;
+
 	for (let name, dev in wireless.devices)
 		if (dev.autostart)
 			dev.check();
@@ -561,6 +575,7 @@ const ubus_obj = {
 
 			return wdev_call(req, (dev) => {
 				dev.update();
+				dev.check();
 				return 0;
 			});
 		}
